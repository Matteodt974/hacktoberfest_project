<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ outline.course_title }} — Lecturify notes</title>
<meta name="generator" content="Lecturify (Gemma 4 via the Gemini API)">
<link rel="stylesheet" href="{{ katex_base }}/katex.min.css">
<script defer src="{{ katex_base }}/katex.min.js"></script>
<script defer src="{{ katex_base }}/contrib/auto-render.min.js"></script>
<style>
:root{
  --bg:#fbfaf7; --paper:#ffffff; --ink:#1f1d1a; --muted:#6b665e; --rule:#e4e0d8;
  --accent:#8a3b12; --accent-soft:#f6ebe3; --img:#2c6e49; --img-soft:#e5f2ea; --tr:#55606e; --tr-soft:#eceff3;
  --serif: Charter, "Bitstream Charter", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
  --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.65 var(--serif)}
a{color:var(--accent)}
.wrap{max-width:860px;margin:0 auto;padding:40px 20px 80px}
.toolbar{position:sticky;top:0;z-index:5;background:rgba(251,250,247,.92);backdrop-filter:blur(6px);
  border-bottom:1px solid var(--rule);font:14px var(--sans)}
.toolbar .in{max-width:860px;margin:0 auto;padding:8px 20px;display:flex;gap:10px;align-items:center}
.toolbar .brand{font-weight:700;letter-spacing:.02em;margin-right:auto}
.toolbar .brand span{color:var(--accent)}
button{font:600 13px var(--sans);border:1px solid var(--rule);background:#fff;color:var(--ink);
  padding:6px 12px;border-radius:6px;cursor:pointer}
button:hover{border-color:var(--accent);color:var(--accent)}
header.course{padding:24px 0 8px;border-bottom:2px solid var(--ink);margin-bottom:28px}
.kicker{font:600 12px var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
h1{font-size:2.2em;line-height:1.15;margin:.25em 0 .4em}
.source{font:14px var(--sans);color:var(--muted)}
.summary{font-size:1.05em}
.prereq{font:14px var(--sans);color:var(--muted)}
.prereq b{color:var(--ink)}
nav.toc{background:var(--paper);border:1px solid var(--rule);border-radius:8px;padding:14px 20px;margin:24px 0 36px;
  font:15px var(--sans)}
nav.toc ol{margin:6px 0 0;padding-left:22px}
nav.toc li{margin:3px 0}
nav.toc .ts{color:var(--muted);font-variant-numeric:tabular-nums;margin-left:6px;font-size:13px}
section.card{background:var(--paper);border:1px solid var(--rule);border-radius:10px;padding:28px 32px;
  margin:0 0 32px;scroll-margin-top:60px}
.card h2{font-size:1.5em;line-height:1.25;margin:0 0 4px}
.card h2 .num{color:var(--accent);margin-right:.35em}
.when{font:14px var(--sans);color:var(--muted);margin-bottom:18px}
.when a{text-decoration:none;font-weight:600}
figure.main{margin:0 0 6px}
figure.main img{width:100%;border-radius:6px;display:block;background:#111}
figure.main figcaption{font:14px/1.5 var(--sans);color:var(--muted);margin-top:8px}
figure.main figcaption b{color:var(--ink)}
.formulas{margin:22px 0 6px}
.formula-list{display:flex;flex-wrap:wrap;gap:4px 18px}
.formula-list .formula{flex:1 1 220px;min-width:0}.formula-list .formula.wide{flex-basis:100%}
.formulas h3,.keys h3{font:700 12px var(--sans);letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin:0 0 8px}
.formula{border-left:3px solid var(--rule);padding:6px 0 6px 14px;margin:8px 0}
.formula.img{border-color:var(--img)}
.formula .tex{overflow-x:auto;overflow-y:hidden}
.formula .meta{font:13px var(--sans);color:var(--muted);display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.badge{font:600 11px var(--sans);padding:2px 8px;border-radius:99px;white-space:nowrap}
.badge.img{background:var(--img-soft);color:var(--img)}
.badge.tr{background:var(--tr-soft);color:var(--tr)}
.badge.v-verified{background:#e5f2ea;color:#2c6e49}.badge.v-corrected{background:#fff4d6;color:#8a5a00}
.badge.v-doubtful{background:#fbe9e9;color:#a4161a}.badge[title]{cursor:help}
.was{font:12px var(--sans);color:var(--muted);margin-top:2px}.was code{font-size:11px}
.notes{margin-top:18px}
.notes h3,.notes h4{font-family:var(--sans);font-size:1em;margin:1.2em 0 .3em}
.notes p{margin:.6em 0}
.katex-display{overflow-x:auto;overflow-y:hidden;padding:4px 0}
.keys{background:var(--accent-soft);border-radius:8px;padding:12px 18px;margin-top:18px}
.keys ul{margin:0;padding-left:20px}
details.saw{margin-top:20px;border-top:1px dashed var(--rule);padding-top:12px;font:14px var(--sans)}
details.saw summary{cursor:pointer;font-weight:600;color:var(--img)}
details.ablation{margin-top:12px;border-top:1px dashed var(--rule);padding-top:12px;font:14px var(--sans)}
details.ablation summary{cursor:pointer;font-weight:600;color:var(--tr)}
.abl-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin:12px 0}
.abl-stats div{background:var(--tr-soft);border-radius:8px;padding:8px 12px}
.abl-stats b{display:block;font-size:20px;color:var(--ink)}
.abl-stats .win{background:var(--img-soft)}.abl-stats .win b{color:var(--img)}
.abl-body{border-left:3px solid var(--tr-soft);padding-left:14px;font:15px/1.6 var(--serif);color:#3a3a3a}
.abl-body h4{font-family:var(--sans)}
.saw .why{margin:10px 0;color:var(--ink)}
.thumbs{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px}
.thumb{position:relative;margin:0;border:2px solid transparent;border-radius:6px;overflow:hidden;opacity:.75}
.thumb.chosen{border-color:var(--img);opacity:1;box-shadow:0 0 0 3px var(--img-soft)}
.thumb img{width:100%;display:block}
.thumb figcaption{position:absolute;left:0;top:0;background:rgba(0,0,0,.7);color:#fff;font:600 11px var(--sans);
  padding:2px 6px;border-bottom-right-radius:6px}
.thumb.chosen figcaption{background:var(--img)}
.proof{font:13px var(--sans);color:var(--muted);margin:-20px 0 30px}
footer{border-top:1px solid var(--rule);margin-top:40px;padding-top:16px;font:13px/1.6 var(--sans);color:var(--muted)}

/* ---------- slides mode: one section per screen ---------- */
body.slides{overflow:hidden;background:#fff}
body.slides .toolbar .hide-in-slides, body.slides header.course, body.slides nav.toc, body.slides footer,
body.slides .proof, body.slides details.saw, body.slides details.ablation{display:none}
body.slides .wrap{max-width:none;padding:0}
body.slides section.card{display:none;position:fixed;inset:44px 0 0 0;margin:0;border:0;border-radius:0;
  padding:3vh 5vw;overflow:auto;font-size:clamp(16px,1.5vw,22px)}
body.slides section.card.active{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);
  grid-template-rows:auto auto 1fr;column-gap:4vw;align-content:start}
body.slides .card h2,body.slides .card .when{grid-column:1/-1}
body.slides figure.main{grid-column:1;grid-row:3}
body.slides .card .side{grid-column:2;grid-row:3}
body.slides .card .notes{display:none}
.slide-count{display:none;font:600 13px var(--sans);color:var(--muted)}
body.slides .slide-count{display:inline}
@media (max-width:760px){body.slides section.card.active{display:block}}

/* ---------- print / PDF ---------- */
@media print{
  body{background:#fff;font-size:11.5pt}
  .toolbar,details.saw,details.ablation,.proof{display:none !important}
  .wrap{max-width:none;padding:0}
  section.card{border:0;padding:0;break-before:page;page-break-before:always}
  figure.main img{max-height:9cm;object-fit:contain}
  a{color:inherit;text-decoration:none}
  .keys{border:1px solid #ddd}
}
@page{margin:1.6cm}
@media (max-width:600px){section.card{padding:20px 18px} h1{font-size:1.7em}}
</style>
</head>
<body>
<div class="toolbar"><div class="in">
  <div class="brand">Lecturify<span>.</span></div>
  <span class="slide-count" id="slideCount"></span>
  <button id="slidesBtn" title="One section per screen — ← / → to navigate, Esc to exit">▶ Slides</button>
  <button class="hide-in-slides" onclick="window.print()">Print / PDF</button>
</div></div>

<div class="wrap">
<header class="course">
  <div class="kicker">Course notes{% if meta.channel %} · {{ meta.channel }}{% endif %}</div>
  <h1>{{ outline.course_title }}</h1>
  {% if timestamps %}<p class="source">From the video <a href="{{ meta.url }}" target="_blank" rel="noopener">“{{ meta.title }}”</a>{% if meta.channel %} by {{ meta.channel }}{% endif %}</p>{% endif %}
  <p class="summary">{{ outline.summary }}</p>
  {% if outline.prerequisites %}<p class="prereq"><b>Prerequisites:</b> {{ outline.prerequisites | join(" · ") }}</p>{% endif %}
</header>

<p class="proof">👁 Gemma 4 looked at {{ n_seen }} frames{% if n_frames %} (out of {{ n_frames }} extracted){% endif %}, chose one figure per section and read {{ n_img_formulas }} formula{{ 's' if n_img_formulas != 1 }} directly from the images. Open “What Gemma saw” under each section.{% if verification %}<br>✓ Chain-of-Verification: <b>{{ verification.counts.verified }} verified</b>, {{ verification.counts.corrected }} corrected, {{ verification.counts.doubtful }} doubtful or not stated in the source — each formula and key point was re-checked by an independent Gemma call that saw only the source frame and transcript, not the draft (hover a badge for the question and answer).{% endif %}{% if ablation_totals %}{% set a = ablation_totals %}<br>🙈 Ablation — same model, same prompt, transcript only, <b>no images</b> ({{ a.compared }}/{{ a.sections }} sections): {{ a.formulas_without }} formula{{ 's' if a.formulas_without != 1 }} instead of {{ a.formulas_with }}, and <b>{{ a.only_with_image }} formula{{ 's' if a.only_with_image != 1 }} exist only because Gemma read them on the frames</b>; {{ a.figures }} figure{{ 's' if a.figures != 1 }} chosen vs none. Open “🙈 Without the images” under each section to compare.{% if not timestamps %} (Screenshots mode: section titles come from the image-grouping step.){% endif %}{% endif %}</p>

<nav class="toc"><b>Contents</b>
<ol>{% for s in sections %}<li><a href="#{{ s.id }}">{{ s.title }}</a>{% if s.start %}<span class="ts">{{ s.start }}</span>{% endif %}</li>{% endfor %}</ol>
</nav>

{% for s in sections %}
<section class="card" id="{{ s.id }}">
  <h2><span class="num">{{ s.n }}.</span>{{ s.title }}</h2>
  <div class="when">{% if s.yt %}<a href="{{ s.yt }}" target="_blank" rel="noopener">▶ {{ s.start }} – {{ s.end }}</a> · watch this part on YouTube{% else %}{{ s.summary }}{% endif %}</div>

  {% if s.figure %}
  <figure class="main">
    <img src="{{ s.figure.src }}" alt="{{ s.caption }}">
    <figcaption><b>Fig. {{ s.n }}{% if s.figure.t %} ({{ s.figure.t }}){% endif %}.</b> {{ s.caption }}</figcaption>
  </figure>
  {% endif %}

  <div class="side">
  {% if s.formulas %}
  <div class="formulas"><h3>Formulas</h3><div class="formula-list">
    {% for f in s.formulas %}
    <div class="formula {{ 'img' if f.from_image else 'tr' }}{{ ' wide' if f.latex|length > 34 }}">
      <div class="tex">$$ {{ f.latex }} $$</div>
      <div class="meta"><span class="badge {{ 'img' if f.from_image else 'tr' }}">{{ '👁 ' if f.from_image else '🗒 ' }}{{ f.badge }}</span>{% if f.check.status %}<span class="badge v-{{ f.check.status }}" title="{{ f.check.tip }}">{{ f.check.icon }} {{ f.check.label }}</span>{% endif %}{{ f.meaning }}</div>
      {% if f.check.correction %}<div class="was">Draft read: <code>{{ f.original }}</code></div>{% endif %}
    </div>
    {% endfor %}
  </div></div>
  {% endif %}

  <div class="notes">{{ s.notes_html }}</div>

  {% if s.key_points %}
  <div class="keys"><h3>Key points</h3><ul>{% for k in s.key_points %}<li>{{ k.html }}{% if k.check.status %} <span class="badge v-{{ k.check.status }}" title="{{ k.check.tip }}">{{ k.check.icon }} {{ k.check.label }}</span>{% endif %}</li>{% endfor %}</ul></div>
  {% endif %}
  </div>

  <details class="saw">
    <summary>👁 What Gemma saw — {{ s.candidates | length }} candidate frame{{ 's' if s.candidates|length != 1 }}{% if s.figure %}, picked image {{ s.figure.n }}{% endif %}</summary>
    <p class="why"><b>Why image {{ s.figure.n if s.figure else '?' }}:</b> {{ s.reason }}</p>
    <div class="thumbs">
      {% for c in s.candidates %}
      <figure class="thumb {{ 'chosen' if c.chosen }}"><img src="{{ c.src }}" alt="Candidate {{ c.n }}" loading="lazy"><figcaption>{{ c.n }}{% if c.t %} · {{ c.t }}{% endif %}{% if c.chosen %} ✓{% endif %}</figcaption></figure>
      {% endfor %}
    </div>
  </details>

  {% if s.ablation %}{% set c = s.ablation.cmp %}
  <details class="ablation">
    <summary>🙈 Without the images — same model, transcript only: {{ c.formulas_without }} formula{{ 's' if c.formulas_without != 1 }} instead of {{ c.formulas_with }}</summary>
    <div class="abl-stats">
      <div class="win"><b>{{ c.only_with_image }}</b>formula{{ 's' if c.only_with_image != 1 }} only found by looking at the frames</div>
      <div class="{{ 'win' if c.figure }}"><b>{{ '1 vs 0' if c.figure else '0 vs 0' }}</b>figure chosen</div>
      <div><b>{{ c.formulas_with }} / {{ c.formulas_without }}</b>formulas with / without images</div>
      <div><b>{{ c.words_with }} / {{ c.words_without }}</b>words with / without images</div>
      {% if c.only_without %}<div><b>{{ c.only_without }}</b>formula{{ 's' if c.only_without != 1 }} only in the text-only notes</div>{% endif %}
    </div>
    <div class="abl-body">
      {% if s.ablation.formulas %}<div class="formula-list">{% for f in s.ablation.formulas %}<div class="formula tr{{ ' wide' if f|length > 34 }}"><div class="tex">$$ {{ f }} $$</div></div>{% endfor %}</div>{% else %}<p><i>No formula without the images.</i></p>{% endif %}
      {{ s.ablation.notes_html }}
      {% if s.ablation.key_points %}<ul>{% for k in s.ablation.key_points %}<li>{{ k }}</li>{% endfor %}</ul>{% endif %}
    </div>
  </details>
  {% endif %}
</section>
{% endfor %}

<footer>
  Generated with <b>Gemma 4 ({{ model }})</b> via the Gemini API · <a href="{{ repo_url }}">Lecturify</a> (MIT).
  {% if stats.calls is defined %}{{ stats.calls }} Gemma call{{ 's' if stats.calls != 1 }}{% if stats.latency_s %}, {{ stats.latency_s }} s total model latency{% endif %}{% if stats.prompt_tokens %}, {{ stats.prompt_tokens }} input / {{ stats.output_tokens }} output tokens{% endif %}.{% endif %}
  {% if timestamps %}Figures are frames from the original video and belong to its creator — for personal study only.{% endif %}
  Gemma can misread a formula: check the source badge.
</footer>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  if (window.renderMathInElement) {
    renderMathInElement(document.body, {
      delimiters: [
        {left: "$$", right: "$$", display: true}, {left: "\\[", right: "\\]", display: true},
        {left: "$", right: "$", display: false}, {left: "\\(", right: "\\)", display: false}
      ],
      throwOnError: false, ignoredTags: ["script", "noscript", "style", "textarea", "pre", "code"]
    });
  }
});
(function () {
  var cards = Array.prototype.slice.call(document.querySelectorAll("section.card"));
  var btn = document.getElementById("slidesBtn"), count = document.getElementById("slideCount");
  var i = 0;
  function show(k) {
    i = Math.max(0, Math.min(cards.length - 1, k));
    cards.forEach(function (c, j) { c.classList.toggle("active", j === i); });
    count.textContent = (i + 1) + " / " + cards.length;
  }
  function enter() {
    var y = window.scrollY, best = 0;
    cards.forEach(function (c, j) { if (c.offsetTop - 80 <= y) best = j; });
    document.body.classList.add("slides"); btn.textContent = "✕ Exit slides"; show(best);
  }
  function exit() {
    document.body.classList.remove("slides"); btn.textContent = "▶ Slides";
    cards.forEach(function (c) { c.classList.remove("active"); });
    if (cards[i]) cards[i].scrollIntoView();
  }
  btn.addEventListener("click", function () { document.body.classList.contains("slides") ? exit() : enter(); });
  document.addEventListener("keydown", function (e) {
    if (!document.body.classList.contains("slides")) return;
    if (e.key === "ArrowRight" || e.key === "PageDown" || e.key === " ") { show(i + 1); e.preventDefault(); }
    else if (e.key === "ArrowLeft" || e.key === "PageUp") { show(i - 1); e.preventDefault(); }
    else if (e.key === "Escape") exit();
  });
})();
</script>
</body>
</html>
